{
  "name": "downrust",
  "private": true,
  "version": "0.1.0",
  "description": "Segmented download manager for the desktop",
  "license": "GPL-3.0-or-later",
  "author": "DownRust contributors",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "theme:build": "astryx theme build src/themes/downrust/downrustTheme.ts && node scripts/theme-header.mjs",
    "tauri": "tauri",
    "extension:lint": "web-ext lint --source-dir extension",
    "extension:build": "web-ext build --source-dir extension --artifacts-dir dist-extension --overwrite-dest --filename downrust-{version}.xpi",
    "extension:zip": "web-ext build --source-dir extension --artifacts-dir dist-extension --overwrite-dest --filename downrust-chrome-{version}.zip",
    "extension:sign": "web-ext sign --channel unlisted --source-dir extension --artifacts-dir dist-extension"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.15",
    "@astryxdesign/theme-neutral": "0.7.15",
    "@stylexjs/stylex": "0.19.2",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@astryxdesign/build": "0.7.15",
    "@astryxdesign/cli": "0.7.15",
    "@babel/core": "7.29.13",
    "@stylexjs/babel-plugin": "0.19.2",
    "@stylexjs/unplugin": "0.19.2",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "6.0.3",
    "unplugin": "2.3.11",
    "vite": "8.3.8",
    "vitest": "3.2.7",
    "web-ext": "8.10.0"
  },
  "browserslist": [
    "last 1 Chrome version"
  ]
}
