{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DownRust",
  "version": "0.2.0",
  "identifier": "com.downrust.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {"label": "main", "title": "DownRust", "width": 1280, "height": 800,
       "minWidth": 960, "minHeight": 600, "center": true, "visible": false,
       "dragDropEnabled": false}
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "copyright": "DownRust contributors",
    "shortDescription": "Segmented download manager",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGNERBQzczOTZCQzE5RTMKUldUakdieVdjNnhOUHdnbURxQXFvbkNYdVRpbTJCZWhUbUhickozdWtoUzVzUjFZNk9sR1N2S3IK",
      "endpoints": ["https://github.com/useruserdev/DownRust/releases/latest/download/latest.json"],
      "windows": {"installMode": "passive"}
    },
    "deep-link": {
      "desktop": {"schemes": ["downrust"]}
    }
  }
}
